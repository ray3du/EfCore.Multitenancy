<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Authors>EfCore.MultiTenancy contributors</Authors>
    <PackageProjectUrl>https://github.com/example/EfCore.MultiTenancy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/example/EfCore.MultiTenancy</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>multitenancy;multi-tenant;postgresql;postgres;efcore;entity-framework;schema;aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
